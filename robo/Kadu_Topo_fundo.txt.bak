//Robo estudo para scaper de 1 renko fechado apos a reversão de nivel de preço 6
//Analisando anual de 2025 , scaper de 45 pontos , gain diario de (lucro)*6 gain 
//Stop financeiro seria de 3 entradas avaliar pelo backtest , então para 10c - stop 700 / gain 540 
Input
Niveis(6);
Topo_Fundo(true);
Levels(false);
PlotMedia(false);
ConsiderarHorario(true);
HorarioInicio(0900);
HorarioFinal(1700);
bolComprar(false);
bolVender(true);
bolAmbos(true);
ContratosTotal(10);
ContratoParcial(5);
ContratoMaiior(10);
RenkoTrueTempoFalse(true);
StopFixo(true);
UltimosXCandles(8);
KeltnerPeriodo(20);
KeltnerDesvio(0.80);
LimiteRenkoBandas(4);
Var
  x,Y,z,vLow,vHigh, MediaCentral : float;
  Compra, Venda, timeok, volok : boolean;
  Entrada, vStop, Risco, vAlvo,vParcial,VStopParcial : float;
  amp, t, f : Real;
  valorStopParcial,valorStopFixo : float;
  bolStopCadastrado : boolean;
  horarioTravado                                                          : boolean;
  i,iguais                                                                : integer;
  tAtual                                                                  : float;
  dAtual                                                                  : integer;
  keltnerCentro, keltnerSuperior, keltnerInferior                         : float;
  renkosAcimaBanda, renkosAbaixoBanda                                     : integer;
  podeBuscarVendas, podeBuscarCompras                                     : boolean;
  condicaoKeltnerCompra, condicaoKeltnerVenda                             : boolean;
Begin

  If time >= HorarioFinal then ClosePosition;


  TimeOk := (Time >= HorarioInicio) e (Time <= HorarioFinal);
  VolOk := Volume > 10000;

  se(RenkoTrueTempoFalse)entao
  begin
  amp := Round(Abs(Abertura[1] - Fechamento[1]));

  Se Abertura[1] > Fechamento[1] então
  inicio
    t := Abertura[1] + amp;
    f := Fechamento[1] - amp;
  fim
  Senao
  inicio
    f := Abertura[1] - amp;
    t := Fechamento[1] + amp;
  fim;
  end;

  se(RenkoTrueTempoFalse=false)entao
  begin
  amp := Round(Abs(Maxima[0] - Minima[0]));

  Se Abertura[0] > Fechamento[0] então
  inicio
    t := Abertura[0] ;
    f := Fechamento[0] ;
  fim
  Senao
  inicio
    f := Abertura[0] ;
    t := Fechamento[0] ;
  fim;
  end;


  X := high;
  Y := low;

  if CurrentBar() = 0 then
    begin
      renkosAcimaBanda := 0;
      renkosAbaixoBanda := 0;
      podeBuscarVendas := true;
      podeBuscarCompras := true;
    end;

  keltnerCentro := MediaExp(KeltnerPeriodo, close);
  keltnerSuperior := keltnerCentro + (ATR(KeltnerPeriodo) * KeltnerDesvio);
  keltnerInferior := keltnerCentro - (ATR(KeltnerPeriodo) * KeltnerDesvio);

  Plot5(keltnerSuperior);
  SetPlotColor(5,(RGB(255,165,0)));
  SetPlotWidth(5,2);
  Plot6(keltnerInferior);
  SetPlotColor(6,(RGB(30,144,255)));
  SetPlotWidth(6,2);

  if Close > keltnerSuperior then
    renkosAcimaBanda := renkosAcimaBanda + 1
  else
    renkosAcimaBanda := 0;

  if Close < keltnerInferior then
    renkosAbaixoBanda := renkosAbaixoBanda + 1
  else
    renkosAbaixoBanda := 0;

  if renkosAcimaBanda >= LimiteRenkoBandas then
    podeBuscarVendas := false;

  if renkosAbaixoBanda >= LimiteRenkoBandas then
    podeBuscarCompras := false;

  VLow := Lowest(low,Niveis);
  VHigh := Highest(high,Niveis);
  MediaCentral := Media(Niveis,close);
  Begin
    If Topo_Fundo = True then
      Begin
        if vHigh <= vHigh[1] then
          begin
            X := X[1];
            PLOT3(x);
            SetPlotColor(3,(RGB(255,0,0)));
            SetPlotWidth(3,3);

          end;
        if vLow >= vLow[1] then
          begin
            Y := y[1];
            PLOT4(y);
            SetPlotColor(4,(RGB(0,255,0)));
            SetPlotWidth(4,3);
           //PlotText(Y,clblue);;
          end;
      End;
    If PlotMedia = True then Plot(MediaCentral);
  End;

  If ConsiderarHorario then
    Begin
      condicaoKeltnerCompra := (Minima[1] < keltnerInferior[1]);
      condicaoKeltnerVenda := (Maxima[1] > keltnerSuperior[1]);

      Compra := (Low < VLow[1]) e (Close > Open) e TimeOk e VolOk e condicaoKeltnerCompra e podeBuscarCompras;
      Venda := (High > VHigh[1]) e (Close < Open) e TimeOk e VolOk e condicaoKeltnerVenda e podeBuscarVendas;
    End
  Else If not ConsiderarHorario then
    Begin
      condicaoKeltnerCompra := (Minima[1] < keltnerInferior[1]);
      condicaoKeltnerVenda := (Maxima[1] > keltnerSuperior[1]);

      Compra := (Low < VLow[1]) e (Close > Open) e VolOk e condicaoKeltnerCompra e podeBuscarCompras;
      Venda := (High > VHigh[1]) e (Close < Open) e VolOk e condicaoKeltnerVenda e podeBuscarVendas;
    End;

  if Compra then
    begin
      podeBuscarVendas := true;
      renkosAcimaBanda := 0;
    end;

  if Venda then
    begin
      podeBuscarCompras := true;
      renkosAbaixoBanda := 0;
    end;


    // ---- calcula se o horário da barra atual repetiu nos últimos X candles
  horarioTravado := false;
    begin
      // Só faz a checagem se há histórico suficiente
      if CurrentBar() >= (UltimosXCandles + 1) then
        // usa API oficial, não BarNumber
        begin
          tAtual := Time;
          // hora/min do candle sendo processado
          dAtual := CurrentDate;
          // garante mesma data
          iguais := 0;
          for i := 1 to UltimosXCandles do
            if (Time[i] = tAtual) and (CurrentDate[i] = dAtual) then
              iguais := iguais + 1;
          // Se TODAS as últimas X barras têm o MESMO horário → trava
          if (iguais = UltimosXCandles) then
            horarioTravado := true;
        end;
    end;

        
  If Compra and not HasPosition then
    Begin                          
     paintbar(cllime);

  se(RenkoTrueTempoFalse)entao
  begin
  vAlvo := (t+(amp*1));
  vParcial := (t);
  VStopParcial:= (f-(amp*1));
  vStop:= (f);
  end;
   
  //CODIGO PARA TEMPO NAO MEXE
  se(RenkoTrueTempoFalse=false)entao
  begin
  vAlvo := (t+(amp*1));
  vStop:= (f-(amp*1));
  end;


  End
  Else If Venda and not HasPosition then
  Begin
   paintbar(clRed);
  se(RenkoTrueTempoFalse)entao
  begin
  vAlvo := (f-(amp*1));
  vStop:= (t);
  end;
   
  //CODIGO PARA TEMPO NAO MEXE
  se(RenkoTrueTempoFalse=false)entao
  begin
  vAlvo := (f-(amp*1));
  vStop:= (t);
  end;
    End;

    
  if not HasPosition then
    Begin
      If TimeOk e VolOk and (bolComprar or bolAmbos) and Compra and (horarioTravado=false) 
      and (SlowStochastic(14,3,1) >=10) and (SlowStochastic(14,3,1) <= 40) then BuyAtMarket(ContratosTotal);
      If TimeOk e VolOk and (bolVender or bolAmbos) and Venda and (horarioTravado=false) 
       and (SlowStochastic(14,3,1) >=50)  and (SlowStochastic(14,3,1) <= 95) then SellShortAtMarket(ContratosTotal);
    End;

 if not HasPosition  then
 bolStopCadastrado :=false;

// Se Comprado ou Vendido faça Saídas de acordo com as instruções abaixo
If IsBought then
  Begin
    SellToCoverLimit(vAlvo,ContratoMaiior);
    se(fechamento[1]>abertura[1]) and (RenkoTrueTempoFalse)entao
    begin
      vStop:= (f);
    end;
    SellToCoverStop(vStop,vStop-50,ContratoMaiior); 
  End;

If isSold then
  Begin
  BuyToCoverLimit(vAlvo,ContratoMaiior);
    se(fechamento[1] < abertura[1]) and (RenkoTrueTempoFalse)entao
    begin
      vStop:= (t);
    end;
  BuyToCoverStop(vStop,vStop+50,ContratoMaiior);
         
End;
end;